{
  "name": "archil",
  "version": "0.0.1",
  "description": "Alias for disk, the Archil client for disks and sandboxes",
  "keywords": [
    "archil",
    "disk",
    "filesystem",
    "sandbox"
  ],
  "homepage": "https://archil.com",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/archil-data/archil-sdk"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "disk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">= 22.19.0"
  }
}
